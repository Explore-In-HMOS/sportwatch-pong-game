<div class="container">
    <div id="game-controllers">
        <input type="button" value="stop" onclick="onStop" id="stop"/>
        <input type="button" value="play" onclick="onPlay" id="play"/>
    </div>
    <canvas
            id="game-canvas"
            ref="gameCanvas"
            ontouchmove="onTouchMove"
            ontouchend="onTouchEnd"
            >
    </canvas>
</div>